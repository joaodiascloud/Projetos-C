#include <stdio.h>

int main(){
	int n;
	scanf("%d", &n);
	
	switch(n){
		case 0: case 1: case 2: case 3: case 4:
			printf("Classificação: Ruim");
			break;
		case 5: case 6: case 7:
			printf("Classificação: Regular");
			break;
		case 8: case 9: case 10:
			printf("Classificação: Ótima");
			break;
		default:
			printf("Valor Inválido");
			break;
	}return 0;
}
